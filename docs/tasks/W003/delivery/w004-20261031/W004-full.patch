+    xs=[Fraction(v['x']['numerator'])/int(v['x']['denominator']) for v in verts];ys=[Fraction(v['y']['numerator'])/int(v['y']['denominator']) for v in verts]
+    assert len(set(zip(xs,ys)))==4 and len(set(xs))==len(set(ys))==2,'UnsupportedNonrectangle'
+    assert all((xs[k]==xs[(k+1)%4]) != (ys[k]==ys[(k+1)%4]) for k in range(4)),'UnsupportedNonrectangle'
+    bbox=dict(zip(['x_min','y_min','x_max','y_max'],map(rat,[min(xs),min(ys),max(xs),max(ys)])))
+    identity=q['object'];join=next(x for x in (ix if ix is not None else nx) if x['layout_instance' if ix is not None else 'lvs_name']==identity)
+    reqref={'path':'query/requests.json','sha256':sha(root/'query/requests.json'),'json_pointer':f'/requests/{request_index}/object','lexeme':identity}
+    fields={'record_id':q['record_ids'][ordinal],'derived_layer':layer,'geometry_kind':'rectangle','quality':'exact','vertices_nm':verts,'bbox_nm':bbox,'unit':'nm','precision':int(precision),'metadata_opaque':[v['lexeme'] for v in metadata],'section_header_opaque':tupleloc['lexeme']}
+    sources={'record_id':{'derivation':'author ordinal label, not a raw identity','sources':[{'path':'query/requests.json','sha256':sha(root/'query/requests.json'),'json_pointer':f'/requests/{request_index}/record_ids/{ordinal}','lexeme':fields['record_id']}]},'derived_layer':derived('verbatim',layerloc),'geometry_kind':derived('prove four distinct axis-aligned rectangle corners',*vsrc),'quality':derived('lossless rectangle proof + selected dialect/derived registry, not raw token',*vsrc),'vertices_nm':derived('raw(y,x) * 1000 / precision nm; preserve vertex order',loc(path,ls,0,1),*vsrc),'bbox_nm':derived('extrema of proven exact vertices',loc(path,ls,0,1),*vsrc),'unit':derived('dialect micrometres/precision converted to nm',loc(path,ls,0,1)),'precision':derived('positive exact geometry precision',loc(path,ls,0,1)),'metadata_opaque':derived('verbatim unknown metadata semantics',*metadata),'section_header_opaque':derived('verbatim; count meanings unverified',tupleloc)}
