  "wheel-identity-310": {
    "cmd": [
      "/workspace/work/w018-env/186c426ea550a6941ead417cd640a86c37017ba5/installed-310/bin/python",
      "-I",
      "-c",
      "\nimport hashlib, json, pathlib, sys\nimport layauto_v2\ndist = pathlib.Path(layauto_v2.__file__).resolve().parent\nassert dist.is_relative_to(pathlib.Path(sys.prefix)) and not dist.is_relative_to(pathlib.Path(sys.argv[1]))\nsource = pathlib.Path(sys.argv[1]) / 'layauto_v2'\nitems = {p.relative_to(source).as_posix(): hashlib.sha256(p.read_bytes()).hexdigest()\n         for p in source.rglob('*') if p.is_file() and p.suffix in ('.py', '.typed')}\nassert all(hashlib.sha256((dist/p).read_bytes()).hexdigest()==sha for p, sha in items.items())\nprint(json.dumps({'module_path': str(dist), 'source_equivalent_files': len(items), 'python': sys.version}))\n",
      "/workspace/work/w018-env/186c426ea550a6941ead417cd640a86c37017ba5/tree"
    ],
